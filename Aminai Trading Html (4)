  function rsi(closes, period){
    period = period||14;
    if(closes.length < period+1) return 50;
    var gains=0, losses=0;
    for(var i=1;i<=period;i++){ var d = closes[i]-closes[i-1]; if(d>0) gains+=d; else losses-=d; }
    var ag = gains/period, al = losses/period;
    for(var j=period+1;j<closes.length;j++){ var dd = closes[j]-closes[j-1]; ag = (ag*(period-1) + (dd>0?dd:0))/period; al = (al*(period-1) + (dd<0?-dd:0))/period; }
