  /* ---------- Backtest on live-fed daily candles ---------- */
  $("#btBtn").addEventListener("click", function(){
    var out = $("#btOut");
    out.innerHTML = '<p style="color:var(--muted);margin:0">Fetching EURUSD daily candles from Kraken and running…</p>';
    fetchJSON("https://api.kraken.com/0/public/OHLC?pair=EURUSD&interval=1440").then(function(d){
      var rows = d.result && d.result.ZEURZUSD;
      if(!rows || rows.length<80) throw new Error("few candles");
      var candles = rows.map(function(r){ return {t:+r[0], o:parseFloat(r[1]), h:parseFloat(r[2]), l:parseFloat(r[3]), c:parseFloat(r[4])}; });
      var closes = candles.map(function(k){ return k.c; });
      var e21 = emaSeries(closes,21), e50 = emaSeries(closes,50);
      var equity = 10000, peak = 10000, maxDD = 0, trades = 0, wins = 0, grossW = 0, grossL = 0;
      var spreadCost = 0.00012;
      for(var i=51;i<candles.length-1;i++){
        if(e21[i]===null || e50[i]===null) continue;
        var slice = closes.slice(0,i+1);
        var r = rsi(slice,14);
        var dir = null;
        if(e21[i]>e50[i] && r<72) dir = "BUY"; else if(e21[i]<e50[i] && r>28) dir = "SELL";
        if(!dir) continue;
        var a = atr(candles.slice(Math.max(0,i-30),i+1),14); if(!a) continue;
        var entry = candles[i+1].o;
        var sl = dir==="BUY" ? entry-a : entry+a;
        var tp = dir==="BUY" ? entry+a*1.67 : entry-a*1.67;
        var exit = null, j;
        for(j=i+1;j<Math.min(i+11,candles.length);j++){
          var k = candles[j];
          if(dir==="BUY"){ if(k.l<=sl){ exit = sl; break; } if(k.h>=tp){ exit = tp; break; } }
          else { if(k.h>=sl){ exit = sl; break; } if(k.l<=tp){ exit = tp; break; } }
        }
        if(exit===null) continue;
        var move = (dir==="BUY" ? exit-entry : entry-exit) - spreadCost;
        var pnl = move/0.0001 * 10 * 0.10; /* 0.10 lot */
        trades++; equity += pnl;
        if(pnl>0){ wins++; grossW += pnl; } else { grossL -= pnl; }
        if(equity>peak) peak = equity;
        var dd = peak>0 ? (peak-equity)/peak*100 : 0; if(dd>maxDD) maxDD = dd;
        i = j;
      }
      var from = new Date(candles[0].t*1000).toISOString().slice(0,10), to = new Date(candles[candles.length-1].t*1000).toISOString().slice(0,10);
      var pf = grossL>0 ? (grossW/grossL).toFixed(2) : "—";
      out.innerHTML = '<div class="ind-grid" style="grid-template-columns:repeat(3,1fr)">' +
        '<div class="ind"><label>Candles / period</label><div class="v">'+candles.length+' D1 · '+from+' → '+to+'</div></div>' +
        '<div class="ind"><label>Trades</label><div class="v">'+trades+'</div></div>' +
        '<div class="ind"><label>Win rate</label><div class="v">'+(trades? (wins/trades*100).toFixed(1)+"%":"—")+'</div></div>' +
        '<div class="ind"><label>Net result (0.10 lot)</label><div class="v" style="color:'+(equity>=10000?"var(--green)":"var(--red)")+'">'+(equity>=10000?"+":"−")+'$'+Math.abs(equity-10000).toFixed(2)+'</div></div>' +
        '<div class="ind"><label>Max drawdown</label><div class="v">'+maxDD.toFixed(1)+'%</div></div>' +
        '<div class="ind"><label>Profit factor</label><div class="v">'+pf+'</div></div></div>' +
        '<p style="color:var(--muted);font-size:13px;margin:10px 0 0">Past performance on these candles is not a promise of future results. Costs modelled as a fixed 1.2-pip spread per trade; slippage and commission vary by broker.</p>';
    }).catch(function(){ out.innerHTML = '<p style="color:var(--red);margin:0">Candle feed unreachable — backtest not run. Nothing was invented in its place.</p>'; });
  });

