  /* ---------- Risk calculator with MT5-style side validation ---------- */
  function calc(){
    var dir = $("#rcDir").value;
    var bal = parseFloat($("#rcBalance").value)||0;
    var risk = parseFloat($("#rcRisk").value)||0;
    var entry = parseFloat($("#rcEntry").value)||0;
    var sl = parseFloat($("#rcSL").value)||0;
    var tp = parseFloat($("#rcTP").value)||0;
    var pipVal = parseFloat($("#rcPip").value)||10;
    var err = $("#rcErr"); err.style.display = "none"; err.textContent = "";
    var problems = [];
    var s = current, ps = pipSize(s);
    if(dir==="BUY"){
      if(sl>=entry) problems.push("BUY: Stop Loss "+fmt(sl,s.dec)+" must be BELOW entry "+fmt(entry,s.dec)+". MT5 will reject this as Invalid S/L.");
      if(tp<=entry) problems.push("BUY: Take Profit "+fmt(tp,s.dec)+" must be ABOVE entry "+fmt(entry,s.dec)+". MT5 will reject this as Invalid T/P.");
    } else {
      if(sl<=entry) problems.push("SELL: Stop Loss "+fmt(sl,s.dec)+" must be ABOVE entry "+fmt(entry,s.dec)+". MT5 will reject this as Invalid S/L.");
      if(tp>=entry) problems.push("SELL: Take Profit "+fmt(tp,s.dec)+" must be BELOW entry "+fmt(entry,s.dec)+". MT5 will reject this as Invalid T/P.");
    }
    var live = s.price;
    if(s.verified){
      if(Math.abs(live-sl) < ps*3) problems.push("Stop Loss is within 3 pips of the LIVE price "+fmt(live,s.dec)+" — too close, a broker spread can reject it.");
      if(Math.abs(tp-live) < ps*3) problems.push("Take Profit is within 3 pips of the LIVE price "+fmt(live,s.dec)+" — too close, a broker spread can reject it.");
    }
    if(problems.length){ err.innerHTML = problems.join("<br>"); err.style.display = "block"; }
    var dist = Math.abs(entry-sl);
    var pips = ps ? dist/ps : 0;
    var riskAmt = bal * risk/100;
    var lot = pips>0 && pipVal>0 ? riskAmt/(pips*pipVal) : 0;
    var rr = dist>0 ? Math.abs(tp-entry)/dist : 0;
    $("#rcOut").innerHTML =
      '<div class="row"><span>Stop distance</span><b>'+pips.toFixed(1)+' pips</b></div>' +
      '<div class="row"><span>Amount at risk</span><b>$'+riskAmt.toFixed(2)+'</b></div>' +
      '<div class="row"><span>Reward : Risk</span><b>'+(rr?rr.toFixed(2):"—")+'</b></div>' +
      '<div class="row"><span>Suggested lot size</span><b style="color:var(--blue2)">'+lot.toFixed(2)+' lots</b></div>' +
      (lot>1 ? '<div class="row"><span style="color:var(--amber)">Warning</span><b style="color:var(--amber)">Above 1.00 lot — very large</b></div>' : '') +
      (problems.length ? '<div class="row"><span style="color:var(--red)">Levels valid?</span><b style="color:var(--red)">NO — see below</b></div>' : '<div class="row"><span style="color:var(--green)">Levels valid?</span><b style="color:var(--green)">YES</b></div>');
  }
