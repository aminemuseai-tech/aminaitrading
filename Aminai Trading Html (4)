<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<meta name="color-scheme" content="dark"/>
<link rel="icon" href="data:,"/>
<title>AMINAI TRADING — Live Platform (HTML)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#05070b; --bg2:#090c12; --panel:#0d1119; --panel2:#111724; --line:#1c2434; --line2:#26314a;
  --text:#e8edf5; --muted:#8b98ad; --muted2:#5f6d84;
  --blue:#2f7bff; --blue2:#4da3ff; --cyan:#22c3d6;
  --green:#22c07a; --green-bg:rgba(34,192,122,.12);
  --red:#f6465d; --red-bg:rgba(246,70,93,.12);
  --amber:#f5b83d; --amber-bg:rgba(245,184,61,.13);
  --radius:10px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font-family:"IBM Plex Sans",system-ui,-apple-system,Segoe UI,sans-serif;font-size:15px;line-height:1.5}
.mono{font-family:"JetBrains Mono",ui-monospace,monospace}
a{color:var(--blue2)}
button{font:inherit;cursor:pointer}
.wrap{max-width:1440px;margin:0 auto;padding:0 18px 48px}
header{position:sticky;top:0;z-index:40;background:rgba(5,7,11,.94);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.head-in{max-width:1440px;margin:0 auto;padding:12px 18px;display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.logo{font-weight:700;letter-spacing:.04em;font-size:20px;white-space:nowrap}
.logo span{color:var(--blue)}
.badge{font-size:11px;font-weight:700;letter-spacing:.08em;padding:4px 8px;border-radius:999px;border:1px solid var(--line2);background:var(--panel2);color:var(--muted);white-space:nowrap;display:inline-flex;align-items:center;gap:6px}
.badge.live{border-color:#14532d;background:var(--green-bg);color:var(--green)}
.badge.stale{border-color:#6b5518;background:var(--amber-bg);color:var(--amber)}
.badge.amber{border-color:#6b5518;background:var(--amber-bg);color:var(--amber)}
.pulse{width:8px;height:8px;border-radius:50%;background:var(--green);flex:none;animation:pulse 1.6s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(34,192,122,.45)}70%{box-shadow:0 0 0 7px rgba(34,192,122,0)}100%{box-shadow:0 0 0 0 rgba(34,192,122,0)}}
@media (prefers-reduced-motion: reduce){.pulse{animation:none}}
.head-actions{margin-left:auto;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.btn{border:1px solid var(--line2);background:var(--panel2);color:var(--text);padding:10px 16px;border-radius:8px;font-weight:600;display:inline-flex;align-items:center;gap:8px}
.btn:hover{border-color:var(--blue)}
.btn.primary{background:var(--blue);border-color:var(--blue);color:#fff}
.btn.primary:hover{background:#1f6bf0}
.btn.danger{background:transparent;border-color:#5a2430;color:#ff8a9a}
.btn.danger:hover{background:var(--red-bg);border-color:var(--red)}
.btn.small{padding:7px 11px;font-size:13px}
.btn:disabled{opacity:.45;cursor:not-allowed}
nav.tabs{display:flex;gap:4px;overflow-x:auto;padding:0 18px;max-width:1440px;margin:0 auto;scrollbar-width:none}
nav.tabs::-webkit-scrollbar{display:none}
nav.tabs button{background:none;border:none;color:var(--muted);padding:10px 14px;font-weight:600;border-bottom:2px solid transparent;white-space:nowrap}
nav.tabs button.active{color:var(--text);border-bottom-color:var(--blue)}
.livebar{margin:18px 0 0;background:linear-gradient(180deg,#0e1a14,#0b101c);border:1px solid #1d3a2a;border-radius:12px;padding:18px 20px;display:flex;gap:18px;align-items:center;flex-wrap:wrap}
.livebar h1{font-size:24px;line-height:1.2;margin:0 0 6px}
.livebar p{margin:0;color:var(--muted);max-width:760px}
.livebar .big{margin-left:auto;text-align:right}
.livebar .big .btn{font-size:16px;padding:14px 22px}
.file-meta{font-size:12px;color:var(--muted2);margin-top:8px}
.file-meta b{color:var(--muted);font-weight:600}
.feedbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:12px;background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:11px 14px;font-size:13px}
.feedbar.stale{border-color:#6b5518;background:rgba(245,184,61,.06)}
.feedbar .sep{width:1px;height:18px;background:var(--line2)}
.feedbar b{color:var(--text)}
.stats{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-top:12px}
.stat{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:13px 14px}
.stat label{display:block;font-size:11px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted2);font-weight:700;margin-bottom:4px}
.stat .v{font-size:19px;font-weight:700}
.stat .s{font-size:12px;color:var(--muted)}
.pos{color:var(--green)} .neg{color:var(--red)}
.grid{display:grid;grid-template-columns:290px 1fr 340px;gap:12px;margin-top:12px;align-items:start}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.panel-h{padding:12px 14px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.panel-h h2{font-size:13px;letter-spacing:.07em;text-transform:uppercase;margin:0;color:var(--text)}
.panel-h .right{margin-left:auto;font-size:12px;color:var(--muted)}
.panel-b{padding:14px}
.wl-row{display:flex;align-items:center;gap:10px;width:100%;text-align:left;background:none;border:none;border-bottom:1px solid var(--line);color:var(--text);padding:11px 14px}
.wl-row:last-child{border-bottom:none}
.wl-row:hover,.wl-row.active{background:var(--panel2)}
.wl-row .dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px rgba(34,192,122,.15);flex:none}
.wl-row .sym{font-weight:700}
.wl-row .sub{font-size:11px;color:var(--muted2)}
.wl-row .pr{margin-left:auto;text-align:right}
.wl-row .chg{font-size:12px}
.wl-row .src{font-size:10px;color:var(--muted2)}
.flash-up{animation:fup .7s}
.flash-down{animation:fdn .7s}
@keyframes fup{0%{color:var(--green)}100%{}}
@keyframes fdn{0%{color:var(--red)}100%{}}
@media (prefers-reduced-motion: reduce){.flash-up,.flash-down{animation:none}}
.tf{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.tf button{background:var(--panel2);border:1px solid var(--line2);color:var(--muted);border-radius:6px;padding:6px 10px;font-weight:700;font-size:12px}
.tf button.active{background:var(--blue);border-color:var(--blue);color:#fff}
.tf button:disabled{opacity:.45;cursor:not-allowed}
.tf select{background:var(--panel2);border:1px solid var(--line2);color:var(--text);border-radius:6px;padding:6px 8px;font:inherit;font-size:13px;font-weight:600}
#chart{width:100%;height:340px;display:block;background:#080b11}
.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted);padding:10px 14px;border-top:1px solid var(--line)}
.legend b{color:var(--text)}
.ind-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.ind{background:var(--bg2);border:1px solid var(--line);border-radius:8px;padding:9px 10px}
.ind label{font-size:11px;color:var(--muted2);font-weight:700;letter-spacing:.05em;text-transform:uppercase;display:block}
.ind .v{font-weight:700;font-size:15px}
.sig{border:1px solid var(--line);border-radius:9px;padding:12px;margin-bottom:10px;background:var(--bg2)}
.sig:last-child{margin-bottom:0}
.sig.stale{border-color:#6b5518;background:rgba(245,184,61,.05)}
.sig.gate{border-color:#5a2430;background:rgba(246,70,93,.05)}
.sig-top{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.dir{font-weight:800;font-size:12px;padding:3px 8px;border-radius:5px;letter-spacing:.05em}
.dir.buy{background:var(--green-bg);color:var(--green)}
.dir.sell{background:var(--red-bg);color:var(--red)}
.chip{font-size:11px;font-weight:700;padding:3px 7px;border-radius:999px;border:1px solid var(--line2);color:var(--muted)}
.chip.strong{color:#0a0f16;background:var(--amber);border-color:var(--amber)}
.chip.lean{color:var(--amber);border-color:#6b5518;background:var(--amber-bg)}
.chip.fresh{color:var(--green);border-color:#14532d;background:var(--green-bg)}
.chip.stale{color:#0a0f16;background:var(--amber);border-color:var(--amber)}
.chip.pause{color:#fff;background:var(--red);border-color:var(--red)}
.chip.warn{color:var(--amber);border-color:#6b5518;background:var(--amber-bg)}
.chip.unver{color:#ffb3c0;border-color:#5a2430;background:var(--red-bg)}
.chip.checks{color:var(--blue2);border-color:#1d335c;background:#0a1424}
.levels{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:10px}
.levels div{background:var(--panel);border:1px solid var(--line);border-radius:7px;padding:7px 8px}
.levels label{font-size:10px;color:var(--muted2);font-weight:700;letter-spacing:.06em;display:block}
.levels .v{font-weight:700;font-size:13px}
.sig p{margin:8px 0 0;font-size:13px;color:var(--muted)}
.sig .actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.checks{list-style:none;margin:10px 0 0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:5px 14px}
.checks li{font-size:12.5px;color:var(--muted);display:flex;gap:7px;align-items:baseline}
.checks .mk{font-weight:800;flex:none}
.checks .mk.buy{color:var(--green)} .checks .mk.sell{color:var(--red)} .checks .mk.none{color:var(--muted2)}
.gatebox{margin-top:10px;border:1px solid #5a2430;background:var(--red-bg);border-radius:8px;padding:10px 12px;font-size:13.5px}
.gatebox.amber{border-color:#6b5518;background:var(--amber-bg)}
.stale-note{color:var(--amber);font-weight:600}
.field{margin-bottom:10px}
.field label{display:block;font-size:12px;font-weight:700;color:var(--muted);margin-bottom:5px}
.field input,.field select{width:100%;background:var(--bg2);border:1px solid var(--line2);color:var(--text);border-radius:7px;padding:9px 10px;font:inherit}
.calc-out{background:#0a1424;border:1px solid #1d335c;border-radius:8px;padding:11px 12px;margin-top:6px}
.calc-out .row{display:flex;justify-content:space-between;padding:3px 0;font-size:14px}
.calc-out .row b{font-family:"JetBrains Mono",monospace}
.calc-err{background:var(--red-bg);border:1px solid #5a2430;color:#ffb3c0;border-radius:8px;padding:10px 12px;margin-top:6px;font-size:13.5px;display:none}
.section{margin-top:12px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px;align-items:start}
table{width:100%;border-collapse:collapse;font-size:14px}
th{text-align:left;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted2);padding:10px 12px;border-bottom:1px solid var(--line)}
td{padding:11px 12px;border-bottom:1px solid var(--line);vertical-align:top}
tr:last-child td{border-bottom:none}
.bot{display:flex;gap:12px;align-items:flex-start;padding:13px 14px;border-bottom:1px solid var(--line)}
.bot:last-child{border-bottom:none}
.bot h3{margin:0 0 3px;font-size:15px}
.bot p{margin:0;color:var(--muted);font-size:13px}
.switch{margin-left:auto;flex:none}
.pill{font-size:11px;font-weight:800;padding:3px 8px;border-radius:999px}
.pill.run{background:var(--green-bg);color:var(--green)}
.pill.pause{background:var(--amber-bg);color:var(--amber)}
.pill.stop{background:var(--panel2);color:var(--muted)}
.event{display:flex;gap:12px;padding:11px 14px;border-bottom:1px solid var(--line);align-items:flex-start}
.event:last-child{border-bottom:none}
.impact{font-size:10px;font-weight:800;padding:3px 7px;border-radius:5px;flex:none;margin-top:2px}
.impact.high{background:var(--red-bg);color:var(--red)}
.impact.med{background:var(--amber-bg);color:var(--amber)}
.impact.low{background:var(--panel2);color:var(--muted)}
.event p{margin:2px 0 0;color:var(--muted);font-size:13px}
.note{background:var(--amber-bg);border:1px solid #6b5518;color:#f3d48a;border-radius:9px;padding:12px 14px;font-size:13.5px;margin-top:12px}
footer{margin-top:22px;border-top:1px solid var(--line);padding-top:16px;color:var(--muted2);font-size:12.5px}
code{background:var(--panel2);border:1px solid var(--line2);border-radius:5px;padding:1px 6px;font-family:"JetBrains Mono",monospace;font-size:.92em}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);display:none;place-items:center;z-index:80;padding:18px}
.modal.open{display:grid}
.modal-card{background:var(--panel);border:1px solid var(--line2);border-radius:12px;max-width:440px;width:100%;padding:22px}
.modal-card h2{margin:0 0 8px;font-size:19px}
.modal-card p{color:var(--muted);margin:0 0 16px}
.modal-actions{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:22px;background:#10233f;border:1px solid var(--blue);color:var(--text);padding:11px 16px;border-radius:9px;font-weight:600;display:none;z-index:90;max-width:92vw;text-align:center}
.toast.show{display:block}
.killed{opacity:.55}
.hitbar{background:#0a1424;border:1px solid #1d335c;border-radius:9px;padding:12px 14px;font-size:13.5px;margin-bottom:12px}
.hitbar b{color:var(--blue2)}
@media(max-width:1100px){
  .grid{grid-template-columns:1fr 1fr}
  .grid .panel:last-child{grid-column:1/-1}
  .stats{grid-template-columns:repeat(3,1fr)}
  .two{grid-template-columns:1fr}
}
@media(max-width:680px){
  .grid{grid-template-columns:1fr}
  .stats{grid-template-columns:repeat(2,1fr)}
  .ind-grid{grid-template-columns:repeat(2,1fr)}
  .levels{grid-template-columns:repeat(2,1fr)}
  .checks{grid-template-columns:1fr}
  #chart{height:280px}
  .livebar .big{margin-left:0;text-align:left;width:100%}
  .livebar .big .btn{width:100%;justify-content:center}
  .head-actions{margin-left:0;width:100%}
  .head-actions .btn{flex:1;justify-content:center}
  table thead{display:none}
  table, tbody, tr, td{display:block;width:100%}
  tr{border-bottom:1px solid var(--line);padding:6px 0}
  td{border-bottom:none;padding:5px 12px}
  td::before{content:attr(data-l);display:block;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted2);font-weight:700}
}
</style>
</head>
<body>

<header>
  <div class="head-in">
    <div class="logo">AMINAI <span>TRADING</span></div>
    <span class="badge live"><span class="pulse"></span>LIVE</span>
    <span class="badge amber">PAPER TRADING — NO BROKER / MT5 CONNECTION</span>
    <div class="head-actions">
      <button class="btn danger" id="killBtn" type="button">Emergency Kill Switch</button>
      <button class="btn primary" id="downloadTop" type="button">Download HTML</button>
    </div>
  </div>
  <nav class="tabs" aria-label="Sections">
    <button class="active" data-go="terminal" type="button">Terminal</button>
    <button data-go="signals" type="button">Signals</button>
    <button data-go="bots" type="button">Bots</button>
    <button data-go="positions" type="button">Positions</button>
    <button data-go="backtest" type="button">Backtest</button>
    <button data-go="calendar" type="button">Calendar</button>
    <button data-go="download" type="button">Download</button>
  </nav>
</header>

<div class="wrap">

  <section class="livebar" id="download">
    <div>
      <h1>AMINAI TRADING — live in one HTML file</h1>
      <p>Open this file and it connects from your browser to real public market feeds — no server, no account, no API key. Prices poll every 10 seconds, the chart draws real Kraken candles, indicators are computed in this page, and every signal is evaluated in this page and anchored to the live price. It updates only while it is open; it does not update in the background when closed.</p>
      <div class="file-meta">File: <b>AMINAI-TRADING-PLATEFORM.html</b> &nbsp;·&nbsp; Feeds: <b>Kraken public API (EURUSD, GBPUSD, BTCUSD, ETHUSD spot + OHLC; USDJPY spot sanity-checked)</b> · <b>Gold-API (XAUUSD spot)</b> · <b>Frankfurter / ECB (USDJPY daily reference)</b></div>
    </div>
    <div class="big">
      <button class="btn primary" id="downloadMain" type="button">Download HTML</button>
      <div class="file-meta">Saves this same live file — open the copy and it reconnects.</div>
    </div>
  </section>

  <div class="feedbar" id="feedbar" role="status" aria-label="Live feed status">
    <span class="badge live" id="feedBadge"><span class="pulse"></span><span id="feedState">CONNECTING…</span></span>
    <span>Last checked <b class="mono" id="lastUpdate">—</b></span>
    <span class="sep"></span>
    <span>Prices refresh <b>every 10s</b></span>
    <span class="sep"></span>
    <span>Signals re-validated <b>every 15s</b></span>
    <span class="sep"></span>
    <span>Next refresh in <b class="mono" id="countdown">10</b>s</span>
    <span style="margin-left:auto"><button class="btn small" id="refreshNow" type="button">Refresh now</button></span>
  </div>
  <div class="note" id="staleWarn" style="display:none"><b>STALE DATA WARNING:</b> <span id="staleWarnTxt">No verified price update for over 30 seconds. Prices below are the last verified values — do not trade from them until the feed recovers.</span></div>

  <section class="stats" aria-label="Paper account">
    <div class="stat"><label>Paper Balance</label><div class="v mono">$10,000.00</div><div class="s">Paper account · this session only</div></div>
    <div class="stat"><label>Paper Equity</label><div class="v mono" id="statEquity">$10,000.00</div><div class="s">Moves with live prices</div></div>
    <div class="stat"><label>Open Paper P&amp;L</label><div class="v mono" id="statToday">$0.00</div><div class="s">Recomputed on every live tick</div></div>
    <div class="stat"><label>Active Bots</label><div class="v mono" id="statBots">2 / 3</div><div class="s">Semi-auto is the default mode</div></div>
    <div class="stat"><label>Open Positions</label><div class="v mono" id="statPos">2</div><div class="s">Paper positions below</div></div>
    <div class="stat"><label>Max Drawdown Guard</label><div class="v mono">5%</div><div class="s">Auto-pause threshold set</div></div>
  </section>

  <section class="grid" id="terminal">
    <div class="panel">
      <div class="panel-h"><h2>Watchlist — Live</h2><span class="right" id="wlTime">—</span></div>
      <div id="watchlist"></div>
      <div class="legend" style="border-top:1px solid var(--line)"><span>Sources: <b>Kraken</b> spot for EURUSD, GBPUSD, BTCUSD, ETHUSD · <b>Gold-API</b> spot for XAUUSD · USDJPY: Kraken spot is illiquid, so each tick is rejected if it jumps more than 3% from the <b>Frankfurter / ECB daily reference</b> (<span class="mono" id="jpyRef">—</span>). Your broker's MT5 price can differ by 1–3 pips — that is normal. Seed prices verified 14 Nov 2026 12:17 UTC and replaced on the first live poll.</span></div>
    </div>

    <div class="panel">
      <div class="panel-h">
        <h2 id="chartTitle">EURUSD · Live Chart</h2>
        <div class="right tf" role="group" aria-label="Chart timeframe" id="chartTf">
          <button data-tf="M5" type="button">M5</button>
          <button data-tf="M30" class="active" type="button">M30</button>
          <button data-tf="D1" type="button">D1</button>
          <button data-tf="W1" type="button">W1</button>
          <button data-tf="MN1" type="button">MN1</button>
        </div>
      </div>
      <canvas id="chart" width="900" height="340" aria-label="Live candlestick chart for the selected symbol"></canvas>
      <div class="legend">
        <span>Entry <b class="mono" id="lgEntry">—</b></span>
        <span>Stop Loss <b class="mono" id="lgSL" style="color:var(--red)">—</b></span>
        <span>Take Profit <b class="mono" id="lgTP" style="color:var(--green)">—</b></span>
        <span id="lgNote">Real candles from the Kraken OHLC feed.</span>
      </div>
      <div class="panel-b">
        <div class="ind-grid" id="indicators"></div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-h"><h2>Risk Calculator</h2><span class="right">Live-price checked</span></div>
      <div class="panel-b">
        <div class="field"><label for="rcDir">Direction</label><select id="rcDir"><option value="BUY">BUY — SL below entry, TP above</option><option value="SELL">SELL — SL above entry, TP below</option></select></div>
        <div class="field"><label for="rcBalance">Account balance ($)</label><input id="rcBalance" type="number" value="10000" min="100" step="100"></div>
        <div class="field"><label for="rcRisk">Risk per trade (%)</label><input id="rcRisk" type="number" value="1" min="0.1" max="5" step="0.1"></div>
        <div class="field"><label for="rcEntry">Entry price (live)</label><input id="rcEntry" type="number" value="1.10086" step="0.00001"></div>
        <div class="field"><label for="rcSL">Stop loss price</label><input id="rcSL" type="number" value="1.10000" step="0.00001"></div>
        <div class="field"><label for="rcTP">Take profit price</label><input id="rcTP" type="number" value="1.10230" step="0.00001"></div>
